FROM ghcr.io/gtsteffaniak/playwright-base:latest AS e2e

# The slim base ships no CA bundle; go mod download needs it for TLS.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# The suite launches the app itself (playwright webServer runs `go run`), so
# the image needs the Go toolchain next to the preinstalled node + browsers.
COPY --from=golang:1.24 /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:$PATH

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

# Reuse the base image's playwright install (/app/frontend/node_modules) and its
# preinstalled firefox build instead of npm ci. The published image is missing
# the chromium binaries, so install the build matching the base's playwright.
# typescript is the only tool the base lacks.
RUN ln -s /app/frontend/node_modules /app/node_modules \
    && npm i -g typescript \
    && cd /app/frontend && npx playwright install --with-deps chromium

COPY . .
RUN go build ./...

WORKDIR /app/tests/e2e
ENV CI=true
# Always copy results out and record the exit code; failing this RUN would make
# the report unreachable since the stage produces no image on failure.
RUN mkdir -p /results \
    && (tsc --noEmit -p tsconfig.json \
        && node /app/frontend/node_modules/@playwright/test/cli.js test; \
        echo $? > /results/EXIT_CODE) \
    && (cp -r playwright-report test-results /results/ 2>/dev/null || true)

# Tiny results image: the loaded artifact is a few MB instead of the full
# toolchain, and reports/traces are retrievable even when tests fail.
FROM scratch
COPY --from=e2e /results /results
CMD ["/results"]
