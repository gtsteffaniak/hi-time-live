FROM ghcr.io/gtsteffaniak/playwright-base:chromium

# The slim base ships no CA bundle; go mod download needs it for TLS. coturn
# provides the relay the relay-only e2e spec connects through.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates coturn \
    && rm -rf /var/lib/apt/lists/*

# The suite launches the app itself (playwright webServer runs `go run`), so
# the image needs the Go toolchain next to the preinstalled node + browsers.
COPY --from=golang /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:$PATH

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

# Reuse the base image's playwright install (/app/frontend/node_modules) and
# chromium build instead of npm ci. Firefox is the only browser the base lacks;
# install it via the base's playwright so the build matches. typescript is the
# only tool the base lacks.
RUN ln -s /app/frontend/node_modules /app/node_modules \
    && npm i -g typescript \
    && cd /app/frontend && npx playwright install --with-deps firefox

COPY . .
RUN go build ./...

WORKDIR /app/tests/e2e
ENV CI=true
# Start a local relay first so the relay-only spec can prove a relay candidate is
# really used. The background process lives for the duration of this layer.
# Both the browser and the relay live in this container, so relayed peer
# addresses are loopback and coturn's default loopback block would forbid them;
# --allow-loopback-peers is test-only and needs a non-empty CLI password. Binding
# to 127.0.0.1 keeps the relay off the container's other interfaces.
RUN tsc --noEmit -p tsconfig.json \
    && (turnserver -n --lt-cred-mech --user hitime:hitime --realm hitime \
        --no-cli --no-tls --no-dtls --fingerprint \
        --allow-loopback-peers --cli-password=hitime \
        --listening-ip 127.0.0.1 \
        --listening-port 3478 --min-port 49160 --max-port 49200 --log-file=stdout &) \
    && sleep 3 \
    && HITIME_TURN_URL=turn:127.0.0.1:3478 HITIME_TURN_USERNAME=hitime HITIME_TURN_CREDENTIAL=hitime \
       node /app/frontend/node_modules/@playwright/test/cli.js test

## don't export layers
FROM scratch